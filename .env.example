# Base Upstash Redis réservée exclusivement à la V2.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret long utilisé uniquement par le job externe qui appelle /api/check.
CRON_SECRET=

# Secret long utilisé pour ouvrir la session admin du dashboard.
ADMIN_SECRET=

# Webhook Discord utilisé uniquement pour le profil Ilan.
DISCORD_WEBHOOK_URL=

# Scripts de smoke test locaux uniquement (ne pas configurer dans Vercel).
SMOKE_BASE_URL=http://localhost:3000
