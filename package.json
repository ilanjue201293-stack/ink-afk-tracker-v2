{
  "name": "ink-afk-tracker-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:redis": "node --env-file=.env.local --import tsx scripts/redis-smoke.ts",
    "test:api": "node --env-file=.env.local --import tsx scripts/api-smoke.ts",
    "check": "npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
